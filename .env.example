# Memgraph Bolt endpoint used by the graph builder and MCP server.
MEMGRAPH_URI=bolt://localhost:7687

# Path to the codebase you want to index. The docker-compose `mcp` service
# mounts this read-only at /repo for get_code_snippet / get_file_outline.
REPO_ROOT=.

# Where the repo is mounted *inside* the MCP container. get_code_snippet stores
# absolute build-time paths in the graph (e.g. /Users/you/repo/src/x.lua); when
# that literal path is absent it remaps the longest matching suffix under this
# root. Default /repo matches the compose mount above — only change if you mount
# the repo elsewhere.
# CODE_GRAPH_REPO_MOUNT=/repo

# --- Optional: middleware filtering for explain_flow ---
# Comma-separated substrings. Default: middleware,filter,/common/,/shared/auth
# CODE_GRAPH_MIDDLEWARE_FILES=middleware,filter,/common/,/shared/auth

# Comma-separated substrings. Default: authenticate,authorize,log_request,rate_limit
# CODE_GRAPH_MIDDLEWARE_FUNCTIONS=authenticate,authorize,log_request,rate_limit

# --- Optional: invocation telemetry for dogfood measurement ---
# When set, each tool call appends one JSONL line (tool, args, duration_ms,
# result_chars, error). Empty/unset = no logging.
# CODE_GRAPH_TELEMETRY_LOG=/tmp/code-graph-telemetry.jsonl

# Optional: override the path where composites.py looks for middleware
# config (defaults to ./config.yml relative to the MCP server CWD).
# CODE_GRAPH_CONFIG=/abs/path/to/config.yml
